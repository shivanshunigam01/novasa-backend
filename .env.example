# Server — Novasa uses 5001 locally so Twinklingz can stay on 5000
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5174,http://localhost:8081,https://novasa.com,https://www.novasa.com

# MongoDB — use a separate database name from other projects
MONGODB_URI=
MONGODB_USER=your_atlas_db_user
MONGODB_PASSWORD=your_db_password
MONGODB_HOST=twinkliz.3histwf.mongodb.net
MONGODB_DB=novasa

# Admin JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First admin (used by npm run seed:admin)
ADMIN_EMAIL=admin@novasa.local
ADMIN_PASSWORD=change-me-novasa

# Cloudinary (URL or separate fields)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=novasa

# Razorpay (secret stays on server only — never commit real keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

STOREFRONT_URL=http://localhost:5174

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-business@gmail.com
SMTP_PASS=16-char-google-app-password
SMTP_FROM="Novasa" <your-business@gmail.com>

INVOICE_LOGO_URL=
